{
  "appId": "com.kurate.app",
  "appName": "KuraTe",
  "webDir": "kurate-app/dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://kurate.drsrv.net.ar",
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
